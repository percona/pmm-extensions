###########
# BUILDER #
###########

FROM localhost/extensions:builder AS builder

#########
# FINAL #
#########

# Consolidated PMM Extensions side-car: the five PMM Extensions services plus a bundled Valkey broker
# under one supervisord. No frontend SPA — the UI is served by PMM.
FROM docker.io/library/python:3.14.10-slim

RUN groupadd --gid 1001 extensions && \
    useradd --gid extensions --shell /usr/sbin/nologin --home-dir /home/extensions --uid 1001 --no-create-home extensions

# Owned by root: the owner of a directory can rename and delete any entry in
# it, so either one owned by extensions would let that user replace what the
# image ships. extensions writes only to $HOME/state, $APP_HOME/var (made
# below), /tmp and mounted volumes.
ENV HOME=/home/extensions
ENV APP_HOME=$HOME/app
RUN install -d -o 0 -g 1001 -m 0750 $HOME && \
    install -d -o 0 -g 1001 -m 0750 $APP_HOME
WORKDIR $APP_HOME

# PMM Extensions owned writable state, owner-only: the minted Grafana token lives here. See
# sidecar/README.md for why a deployment mounts a volume over it.
RUN install -d -o 1001 -g 1001 -m 0700 $HOME/state

# netcat backs the migration wait-loops in supervisord.conf. The upgrade is
# paired with the base pin rather than trusted to it: the pinned tag still
# ships util-linux 2.41-5, whose fix Debian published as 2.41.5-0+deb13u1
# after the tag was cut.
#
# No rendering libraries are installed. libpango-1.0-0, libpangoft2-1.0-0,
# fontconfig, fonts-dejavu and shared-mime-info must return if `report` is
# ever added to sidecar/settings.yaml's EXTENSIONS.APPS: app/extensions/apps/report/service.py
# imports weasyprint at module scope, and this image strips that package
# instead of backing it.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends netcat-openbsd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Purge the packages whose findings nothing in this image can reach. This must
# stay the final package-manager operation in the recipe: it breaks debconf,
# which is a perl program, so apt and dpkg stop working from here on.
# scripts/check_sidecar_purge.py enforces both halves of that invariant.
#
# Each package must come back the moment its condition below holds:
#   perl-base     - anything running inside this container executes perl
#   gzip          - anything running inside this container shells out to gzip/zcat
#   libncursesw6  - a shipped program links wide-character ncurses
#   ncurses-base  - a supported workflow needs terminfo inside the container
#   ncurses-bin   - a supported workflow needs tput/clear/infocmp
#
# The util-linux set goes as one unit. Trivy reports an OS finding against
# every binary package built from the affected source, so removing only the
# packages that carry the vulnerable binaries clears no finding at all.
#   mount         - anything in this container mounts or unmounts a filesystem
#   util-linux    - a shipped program runs nsenter, su, flock, dmesg or lsblk
#   login         - a shipped workflow logs in or switches user
#   bsdutils      - a shipped program runs logger, renice or wall
#   libuuid1      - a shipped wheel links libuuid; CPython's _uuid extension
#                   does, and falls back silently, so uuid1() degrades here
#   libblkid1     - a retained program links libblkid
#   libmount1     - a retained program links libmount
#   libsmartcols1 - a retained program links libsmartcols
#   liblastlog2-2 - a retained program links liblastlog2
#
# libsystemd0 and libudev1 are deliberately NOT here: valkey-server links
# libsystemd.so.0, and both packages carry the same finding, so neither can go.
# login is a *protected* package, which --force-remove-essential does not
# cover on its own; without the second flag dpkg exits 1 and the build fails.
RUN dpkg --purge --force-remove-essential --force-remove-protected \
        perl-base \
        gzip \
        libncursesw6 \
        ncurses-base \
        ncurses-bin \
        mount \
        util-linux \
        login \
        bsdutils \
        libuuid1 \
        libblkid1 \
        libmount1 \
        libsmartcols1 \
        liblastlog2-2

COPY --from=builder /usr/src/extensions/wheels /wheels
COPY --from=builder /usr/src/extensions/requirements.txt .
RUN pip install --no-cache-dir /wheels/*

# Bundled Valkey broker: the server, plus the cli the healthcheck pings
COPY --from=docker.io/valkey/valkey:8-bookworm \
    /usr/local/bin/valkey-server /usr/local/bin/valkey-cli /usr/local/bin/

# Container process manager; pinned here rather than in poetry.lock because the
# standalone image shares that lock and does not use supervisord
RUN pip install --no-cache-dir supervisor==4.3.0 && \
    pip uninstall --yes pip

# Side-car runtime inputs; alembic.ini backs the migration one-shots
COPY --chown=0:1001 --chmod=440 ./alembic.ini .
COPY --chown=0:1001 --chmod=440 ./sidecar/supervisord.conf ./supervisord.conf
COPY --chown=0:1001 --chmod=550 ./sidecar/healthcheck.sh ./healthcheck.sh
COPY --chown=0:1001 --chmod=550 ./sidecar/entrypoint.sh ./entrypoint.sh
# Invoked directly by each API program's command rather than through an
# interpreter, hence 550 where the python helpers below are 440
COPY --chown=0:1001 --chmod=550 ./sidecar/wait_for_schema.sh ./wait_for_schema.sh
# Run directly by an operator through `docker exec`, never by supervisord, hence
# 550 like the gate above
COPY --chown=0:1001 --chmod=550 ./sidecar/clear_sentinels.sh ./clear_sentinels.sh
# Sourced by entrypoint.sh, never executed, hence 440 rather than 550
COPY --chown=0:1001 --chmod=440 ./sidecar/settings-env.sh ./settings-env.sh
# Run through the interpreter and never executed directly -- encryption_key.py and
# grafana_service_account.py by entrypoint.sh, wait_for_api.py by supervisord's
# celery-beat command -- so 440 for the same reason. Copied explicitly because
# bundle.tgz carries app/ and snippets/ only -- no sidecar/ helper reaches the
# runtime image on its own.
COPY --chown=0:1001 --chmod=440 ./sidecar/encryption_key.py ./encryption_key.py
COPY --chown=0:1001 --chmod=440 ./sidecar/grafana_service_account.py ./grafana_service_account.py
COPY --chown=0:1001 --chmod=440 ./sidecar/runtime.py ./sidecar/runtime.py
COPY --chown=0:1001 --chmod=440 ./sidecar/wait_for_api.py ./wait_for_api.py

ADD --chown=0:1001 --chmod=440 bundle.tgz $APP_HOME

# The baked embedded profile. Copied after the bundle so it stays authoritative
# even if `make pack` ever starts shipping a settings.yaml; a bind mount at this
# path still replaces it wholesale.
COPY --chown=0:1001 --chmod=440 ./sidecar/settings.yaml ./settings.yaml

# Strip every app package the baked profile does not activate. The retained set
# is derived from settings.yaml and named nowhere in this recipe.
ARG EXTENSIONS_RESTRICT_APPS=0
COPY --chown=0:0 --chmod=400 ./sidecar/restrict_apps.py /tmp/restrict_apps.py
RUN if [ "$EXTENSIONS_RESTRICT_APPS" = "1" ]; then \
        python /tmp/restrict_apps.py settings.yaml app/extensions/apps; \
    fi && \
    rm -f /tmp/restrict_apps.py

# No compose file injects this for the side-car, so the loader would otherwise
# fall back to the development defaults
ENV FASTAPI_ENV=production_docker

# Every program's stdout is a supervisord pipe, not a tty, so unbuffer it to
# keep `docker logs` complete when a program dies
ENV PYTHONUNBUFFERED=1

# go-w because ADD applies neither --chown nor --chmod to an extracted archive's
# entries, and git archive leaves them group-writable: a side-car started with
# the supplementary group 0, as PMM's compose file starts it, could write there.
RUN chmod -R u+X,g+X,go-w $APP_HOME

# The one directory under $APP_HOME the side-car writes: the Celery worker's
# state file and the atw app's staged bundles go here (CELERY.WORKER_STATE_DB and
# EXTENSIONS.ATW.bundle_dir in settings.yaml, both relative to $APP_HOME). Made
# after the chmod above, which would add group search to it.
RUN install -d -o 1001 -g 1001 -m 0700 $APP_HOME/var

USER extensions

HEALTHCHECK --interval=15s --timeout=15s --start-period=150s --retries=5 \
    CMD ["/home/extensions/app/healthcheck.sh"]

ENTRYPOINT ["/home/extensions/app/entrypoint.sh"]
