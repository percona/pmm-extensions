{
  "capabilities": {
    "alert_on_fail": false,
    "chaining": true,
    "pii_anonymization": false,
    "scheduling": false,
    "stats": false
  },
  "description": "Configure and run Percona Backup for MongoDB (PBM) logical or physical restore operations.",
  "display_name": "MongoDB Restores",
  "forms": [
    {
      "advanced": false,
      "collapsed_by_default": false,
      "collapsible": false,
      "fields": [
        {
          "default": "mongodb-restore",
          "label": "Task Name",
          "min_length": 1,
          "name": "task_name",
          "required": true,
          "sensitive": false,
          "type": "string"
        },
        {
          "label": "Execution Host",
          "name": "hostname",
          "required": true,
          "target_service": "service_id",
          "type": "host"
        },
        {
          "label": "Database Service",
          "name": "service_id",
          "required": false,
          "service_types": [
            "mongodb"
          ],
          "type": "service"
        },
        {
          "choices": [
            {
              "label": "Logical",
              "value": "pbm_logical"
            },
            {
              "label": "Physical",
              "value": "pbm_physical"
            }
          ],
          "label": "Backup Type",
          "name": "backup_type",
          "required": true,
          "type": "choice"
        },
        {
          "description": "Backup name or timestamp (e.g. 2025-12-15T19:04:05Z)",
          "label": "Backup Source",
          "name": "backup_source",
          "required": true,
          "sensitive": false,
          "type": "string"
        },
        {
          "description": "Optional path to MongoDB URI credentials on the Nomad node",
          "label": "Credentials Path",
          "name": "credentials_path",
          "required": false,
          "sensitive": false,
          "type": "string"
        }
      ],
      "render_after_submit": false,
      "title": "Task"
    },
    {
      "advanced": false,
      "collapsed_by_default": true,
      "collapsible": true,
      "fields": [
        {
          "description": "Optional database or collection patterns to restore, separated by commas (for example, db1.*,db2.collection)",
          "label": "Namespace Filter",
          "name": "restore_namespace_filter",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "label": "Batch Size",
          "name": "restore_batch_size",
          "required": false,
          "type": "integer"
        },
        {
          "label": "Insertion Workers",
          "name": "restore_num_insertion_workers",
          "required": false,
          "type": "integer"
        },
        {
          "label": "Parallel Collections",
          "name": "restore_num_parallel_collections",
          "required": false,
          "type": "integer"
        },
        {
          "label": "Download Workers",
          "name": "restore_num_download_workers",
          "required": false,
          "type": "integer"
        },
        {
          "label": "Max Download Buffer (MB)",
          "name": "restore_max_download_buffer_mb",
          "required": false,
          "type": "integer"
        },
        {
          "label": "Download Chunk Size (MB)",
          "name": "restore_download_chunk_mb",
          "required": false,
          "type": "float"
        },
        {
          "label": "Mongod Location",
          "name": "restore_mongod_location",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "label": "Mongod Location Map (YAML)",
          "name": "restore_mongod_location_map",
          "required": false,
          "type": "textarea"
        }
      ],
      "render_after_submit": false,
      "title": "Restore Options"
    }
  ],
  "item_display_name": "restore",
  "item_display_name_plural": "restores",
  "list_view": {
    "columns": [
      {
        "key": "name",
        "label": "Name",
        "sortable": true
      },
      {
        "format": "status",
        "key": "status",
        "label": "Status",
        "sortable": false
      },
      {
        "key": "hostname",
        "label": "Execution Host",
        "sortable": false
      },
      {
        "format": "chip",
        "key": "backup_type",
        "label": "Type",
        "sortable": false,
        "value_labels": {
          "pbm_config": "PBM Config",
          "pbm_incremental": "PBM Incremental",
          "pbm_logical": "PBM Logical",
          "pbm_physical": "PBM Physical",
          "pbm_snapshot": "PBM Snapshot",
          "pbm_status": "PBM Status"
        }
      },
      {
        "key": "backup_source",
        "label": "Backup Source",
        "sortable": false
      },
      {
        "format": "relative",
        "key": "created_at",
        "label": "Created",
        "sortable": false
      },
      {
        "format": "relative",
        "key": "last_executed_at",
        "label": "Last Executed",
        "sortable": false
      },
      {
        "key": "created_by",
        "label": "Created By",
        "sortable": false
      }
    ],
    "default_sort": "name",
    "overview_hidden_fields": []
  },
  "name": "backup_mongo_restores",
