          "name": "fail_on_stopped_replication",
          "required": false,
          "type": "bool"
        },
        {
          "default": false,
          "description": "Truncate the replicate table before starting",
          "label": "Truncate Replicate Table",
          "name": "truncate_replicate_table",
          "required": false,
          "type": "bool"
        }
      ],
      "render_after_submit": false,
      "title": "Flags"
    },
    {
      "advanced": false,
      "collapsed_by_default": false,
      "collapsible": false,
