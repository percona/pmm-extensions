          "label": "Set Vars",
          "name": "set_vars",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "default": "Threads_running=50",
          "description": "Pause when any GLOBAL STATUS variable exceeds this threshold",
          "label": "Max Load",
          "name": "max_load",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "default": "0.5",
          "description": "Target execution time per chunk in seconds",
          "label": "Chunk Time",
          "name": "chunk_time",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "default": "150",
          "description": "Pause until replica lag falls below this value (seconds)",
          "label": "Max Lag",
          "name": "max_lag",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "default": "",
          "description": "Absolute path to a MySQL options file on the executor node. pt-table-checksum reads MySQL options only from this file. The path must already exist on the executor; PMM Extensions does not verify it.",
          "label": "Defaults File",
          "name": "defaults_file",
          "required": false,
          "sensitive": false,
          "type": "string"
        }
      ],
      "render_after_submit": false,
      "title": "Advanced"
    }
