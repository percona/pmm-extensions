        {
          "description": "Execution pauses while this file exists",
          "label": "Pause File",
          "name": "pause_file",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "default": "time,10",
          "description": "Print progress reports to STDERR (e.g. time,10)",
          "label": "Progress",
          "name": "progress",
          "required": false,
          "sensitive": false,
          "type": "string"
        },
        {
          "default": "transaction_isolation='READ-COMMITTED',lock_wait_timeout=5",
