""" PBM Incremental Payload """

from __future__ import annotations

import json
import subprocess
import os
import sys
import yaml


# --- BEGIN GENERATED PBM CREDS PREAMBLE ---
def _creds_path(config_source: str) -> str:
    """Resolve the MongoDB URI credentials path from ``NOMAD_META_CONFIG``.

    :param config_source: The config surface named in the error message, either
        ``"backup"`` or ``"restore"``.
    :return: The credentials-file path (from the config or the ``$HOME`` fallback).
    """
    config_yaml = os.environ.get("NOMAD_META_CONFIG")
    if config_yaml:
        try:
            config = yaml.safe_load(config_yaml)
            if isinstance(config, dict):
                path = config.get("credentials_path")
                if path:
                    return path
        except yaml.YAMLError as err:
            print(
                f"Failed to parse NOMAD_META_CONFIG as YAML: {err}. Falling back to HOME-based credentials path.",
                file=sys.stderr,
            )
    envhome = os.environ.get("HOME")
    if not envhome:
        print(
            f"PBM credentials path not set (credentials_path in {config_source} config) and HOME is unset",
            file=sys.stderr,
        )
        sys.exit(1)
    return f"{envhome}/.mongodb_uri"


def _creds_path_from_config(config: object, config_source: str = "restore") -> str:
    """Resolve the MongoDB URI credentials path from an already-parsed config dict.

    :param config: The parsed restore/backup config value. Anything other than a
        ``dict`` (``None``, a bare scalar, a list, ...) is treated as missing config,
        since ``yaml.safe_load`` can legally return a truthy non-dict.
    :param config_source: The config surface named in the error message, either
        ``"backup"`` or ``"restore"``.
    :return: The credentials-file path (from the config or the ``$HOME`` fallback).
    """
    if isinstance(config, dict):
        path = config.get("credentials_path")
        if isinstance(path, str) and path:
            return path
    envhome = os.environ.get("HOME")
    if not envhome:
        print(
            f"PBM credentials path not set (credentials_path in {config_source} config) and HOME is unset",
            file=sys.stderr,
        )
        sys.exit(1)
    return f"{envhome}/.mongodb_uri"


def pbm_creds(creds_path: str) -> str:
    """Read the MongoDB URI from ``creds_path``, exiting 1 on any read failure.

    :param creds_path: The resolved credentials-file path to read.
    :return: The stripped MongoDB URI read from the file.
    """
    try:
        with open(creds_path, encoding="utf-8") as fpt:
            return fpt.read().strip()
    except FileNotFoundError as err:
        print(f"Credentials file not found: {creds_path}: {err}", file=sys.stderr)
        sys.exit(1)
    except PermissionError as err:
        print(
            f"Permission denied reading credentials file {creds_path}: {err}",
            file=sys.stderr,
        )
        sys.exit(1)
    except OSError as err:
        print(f"Error reading credentials file {creds_path}: {err}", file=sys.stderr)
        sys.exit(1)
    except Exception as err:
        print(f"Error reading credentials file {creds_path}: {err}", file=sys.stderr)
        sys.exit(1)
# --- END GENERATED PBM CREDS PREAMBLE ---


def _load_config():
    """Return NOMAD_META_CONFIG parsed as a dict, or {} when absent.

    A present-but-unparseable or non-mapping config aborts rather than silently
    running a full backup (or using stale cluster-wide storage).
    """
    config_yaml = os.environ.get('NOMAD_META_CONFIG')
    if not config_yaml:
        return {}
    try:
        config = yaml.safe_load(config_yaml)
    except yaml.YAMLError as err:
        print(f'Failed to parse NOMAD_META_CONFIG as YAML: {err}', file=sys.stderr)
        sys.exit(1)
    if isinstance(config, dict):
        return config
    print('NOMAD_META_CONFIG did not parse to a mapping.', file=sys.stderr)
    sys.exit(1)


def _compression_flags(config):
    """ Build pbm backup --compression / --compression-level flags from the backup config.

    Returns [] when no compression is configured so PBM keeps its own default.
    --compression-level is only emitted alongside --compression.
    """
    backup = config.get('backup')
    if not isinstance(backup, dict):
        return []
    compression = backup.get('compression')
    if not compression:
        return []
    flags = ['--compression', str(compression)]
    level = backup.get('compressionLevel')
    if level is not None:
        flags += ['--compression-level', str(level)]
    return flags


def _needs_incremental_base() -> bool:
    """Return True when the cluster has no incremental backup base yet.

    Inspect ``pbm list -o json`` for any snapshot whose type mentions
    incremental. Abort when listing fails or cannot be parsed — guessing
    ``--base`` on a transient failure would start an unintended new chain.
    """
    try:
        result = subprocess.run(  # noqa: S603 # nosec B603
            ['pbm', 'list', '-o', 'json'],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as err:
        print(f'Failed to query pbm list for incremental base: {err}', file=sys.stderr)
        sys.exit(1)
    if result.returncode != 0:
        print(
            'Failed to query pbm list for incremental base '
            f'(exited {result.returncode}).',
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        payload = json.loads(result.stdout or '') or {}
    except json.JSONDecodeError as err:
        print(f'Failed to parse pbm list JSON: {err}', file=sys.stderr)
        sys.exit(1)
    snapshots = []
    if isinstance(payload, dict):
        value = payload.get('snapshots')
        if isinstance(value, list):
            snapshots = value
    for entry in snapshots:
        if not isinstance(entry, dict):
            continue
        backup_type = str(entry.get('type') or '').lower()
        if 'incremental' in backup_type:
            return False
    return True


def pbm():
    """ PBM Incremental Payload """

    os.environ['PBM_MONGODB_URI'] = pbm_creds(_creds_path('backup'))
    config = _load_config()
    cmd = ['pbm', 'backup', '--type', 'incremental']
    if _needs_incremental_base():
        cmd.append('--base')
    cmd += ['--wait'] + _compression_flags(config)

    try:
        proc = subprocess.Popen(cmd)
        proc.wait()
        ret_code = proc.poll()
        if ret_code != 0:
            sys.exit(ret_code)

    except OSError as err:
        print(f'Failed to run pbm: {err}', file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    pbm()
