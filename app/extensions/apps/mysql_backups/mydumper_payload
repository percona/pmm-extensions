def _is_backup_day_name(name: str) -> bool:
    """Return whether a directory name is a real calendar day, not just digit-shaped.

    ``BACKUP_DIR_REGEX`` and ``_list_backups``'s own pattern both used to accept a
    malformed date such as ``20261345`` or ``20260230``. Letting one through only
    cost the post-publish purge, but ``_retained_days`` is now also reached from
    inside ``run()``'s try block, where the resulting ``ValueError`` would discard a
    completed dump instead of publishing it.

    :param name: The directory name to check.
    :return: True when ``name`` is a valid ``YYYYMMDD`` calendar date.
    """
    if not re.search(BACKUP_DIR_REGEX, name):
        return False
    try:
        datetime.datetime.strptime(name, "%Y%m%d")
    except ValueError:
        return False
    return True


