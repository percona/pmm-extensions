def md5sum_file(filename: str) -> str:
    """Calculate the MD5 checksum of a file.

    :param filename: Path to the file.
    :return: MD5 checksum as a hex string.
    """
    d = hashlib.md5()
    fpath = Path(filename)
    with fpath.open("rb") as f:
        buf = f.read(8192)
        while buf:
            d.update(buf)
            buf = f.read(8192)
    return d.hexdigest()


def get_dir_dict(
    path: str, md5: bool = False, json_cache_file: "str | None" = None
) -> "dict[str, dict[str, int | str | None]]":
    """Create a dictionary of files in a directory, including inode, size, and optional MD5.

    :param path: Directory path.
    :param md5: Whether to compute MD5 checksums.
    :param json_cache_file: Path to a JSON cache file to store results.
    :return: Dictionary with file info keyed by relative file path.
    """
    ppath = Path(path)
    if json_cache_file is None:
        json_cache_file = str(ppath / MD5SUM_FILE)
    ret: dict[str, dict[str, int | str | None]] = {}

    for p in ppath.rglob("*"):
        if p.is_file() and not p.name.endswith(".gpg") and p.name != MD5SUM_FILE:
            stat_data = p.stat()
            rel_path = str(p.relative_to(ppath))
            file_md5 = md5sum_file(str(p)) if md5 else None
            ret[rel_path] = {
                "inode": stat_data.st_ino,
                "size": stat_data.st_size,
                "md5": file_md5,
            }

    write_dict(ret, json_cache_file)
    return ret


def load_dir_dict(
    dir_path: str, json_file: "str | None" = None
) -> "dict[str, dict[str, int | str | None]]":
    """Load a directory dictionary from a JSON file if it exists, otherwise create it.

    :param dir_path: Directory path.
    :param json_file: JSON filename. If not provided, MD5SUM_FILE is used.
    :return: Directory dictionary.
    """
    pdir = Path(dir_path)
    json_cache_file = pdir / (json_file if json_file else MD5SUM_FILE)

    if not json_cache_file.is_file():
        get_dir_dict(dir_path, md5=False, json_cache_file=str(json_cache_file))

    with json_cache_file.open("r") as f:
        return json.load(f)


def write_dict(dictionary: dict[Any, Any], json_file: str) -> None:
