def _replica_backup_flags(replica_info: bool, stop_replica: bool) -> list[str]:
    """Return the replica-related xtrabackup CLI flags for the given options.

    ``--safe-slave-backup`` lets xtrabackup own the replica SQL-thread pause and
    satisfies the ``--slave-info`` startup guard (MY-011825), which on a
    multi-threaded replica with GTID off otherwise aborts the backup. Tying it
    to ``stop_replica`` means PMM Extensions no longer runs its own STOP/START REPLICA.

    :param replica_info: Whether ``XTRABACKUP_REPLICA_INFO`` is enabled.
    :param stop_replica: Whether ``XTRABACKUP_STOP_REPLICA`` is enabled.
    :return: The ordered list of replica flags to append to the command.
    """
    flags = []
    if replica_info:
        # xtrabackup 8.4 still uses this argument name
        flags.append('--slave-info')
    if stop_replica:
        flags.append('--safe-slave-backup')
    return flags


ENCRYPTION_FORMATS = ('none', 'gpg', 'aes256', 'dual')


def _resolve_encryption(selected: "str | None", keyfile: "str | None", *,
                        gpg: bool) -> tuple[str, bool, bool]:
    """Return ``(format, aes256, gpg)`` for the encryption this run must apply.

    ``ENCRYPTION_FORMAT`` is authoritative: it, not which fields happen to be
    populated, decides whether AES-256 and GPG run, so a key file or post-run flag
    left behind by an earlier config cannot add an encryption pass of its own.

    A config predating the selector — or carrying a value this payload does not
    know — falls back to the historical inference so its behaviour is unchanged.
    The unknown-value case deliberately shares that branch: silently reading it as
    "no encryption" would ship a plaintext backup for a job that asked to be
    encrypted.

    :data:`ENCRYPTION_FORMATS` is ordered so a format's index encodes its passes —
    bit 1 is AES-256, bit 0 is GPG — which is what makes the inference a lookup
    rather than a second copy of the mode table.

    :param selected: The configured ``ENCRYPTION_FORMAT``, if any.
    :param keyfile: Path to the AES-256 keyfile, or falsy if not configured.
    :param gpg: Whether any GPG timing is configured. The two phases read
        different ones — the backup phase only ever applies GPG post-run, while
        the upload phase applies it in place too — so each passes its own.
    :return: The resolved format name and whether it runs AES-256 and GPG.
    """
    if selected not in ENCRYPTION_FORMATS:
        selected = ENCRYPTION_FORMATS[bool(keyfile) * 2 + bool(gpg)]
    return selected, selected in ('aes256', 'dual'), selected in ('gpg', 'dual')


