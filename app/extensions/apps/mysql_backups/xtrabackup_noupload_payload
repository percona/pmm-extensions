def hardlink_dirs(
    src_dir: str, dest_dir: str, encrypted: bool = False
) -> dict[str, tuple[int, int]]:
    """Hardlink matching files from src_dir to dest_dir if size and MD5 match.

    :param src_dir: Source directory.
    :param dest_dir: Destination directory.
    :param encrypted: Whether the files are encrypted.
    :return: Dictionary of hardlinked files with their inode and size.
    """
    src_p = Path(src_dir)
    dest_p = Path(dest_dir)
    ret: dict[str, tuple[int, int]] = {}
    dir1 = load_dir_dict(src_dir)
    dir2 = load_dir_dict(dest_dir)

    for file in list(dir1.keys()):
        if file in dir2:
            md51 = dir1[file]["md5"]
            inode1 = dir1[file]["inode"]
            size1 = dir1[file]["size"]

            md52 = dir2[file]["md5"]
            inode2 = dir2[file]["inode"]
            size2 = dir2[file]["size"]

            if size1 and size2 and size1 == size2 and inode1 != inode2:
                file1 = src_p / file
                file2 = dest_p / file
                if encrypted:
                    file1_enc = file1.with_suffix(file1.suffix + ".gpg")
                    link_name = file2.with_suffix(file2.suffix + ".gpg")
                    if md51 is None:
                        md51 = md5sum_file(str(file1_enc))
                    if md52 is None:
                        md52 = md5sum_file(str(file2))
                    if md51 == md52:
                        if file2.is_file():
                            file2.unlink()
                        if link_name.is_file():
                            link_name.unlink()
                        os.link(str(file1_enc), str(link_name))
                        ret[file] = (int(inode1), int(size1))
                        inode2 = inode1
                else:
                    if md51 is None:
                        md51 = md5sum_file(str(file1))
                    if md52 is None:
                        md52 = md5sum_file(str(file2))
                    if md51 == md52:
                        if file2.is_file():
                            file2.unlink()
                        os.link(str(file1), str(file2))
                        ret[file] = (int(inode1), int(size1))
                        inode2 = inode1

            dir1[file] = {"inode": inode1, "size": size1, "md5": md51}

    json_cache_file = str(Path(src_dir) / MD5SUM_FILE)
    write_dict(dir1, json_cache_file)
    return ret


def get_dir_size(start_path: str, unit: str = "text") -> "int | str":
    """Get the size of a directory.

    :param start_path: Directory path.
    :param unit: Unit of measure: 'text', 'bytes', 'mb', or 'gb'.
    :return: Size in the requested unit. If 'text', returns human-readable string.
    """
    cmd = [DU_BIN, "-sB1", str(Path(start_path))]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = proc.communicate()
    if proc.returncode != 0:
        logging.warning("Problem running %s: %s", " ".join(cmd), err)
        return 0

    try:
        total_size_str, _ = out.strip().split()
        total_size = int(total_size_str)
    except Exception:
        logging.warning("Invalid du output: %s", out, exc_info=True)
        return 0

    if unit == "bytes":
        return total_size
    mbyte = total_size / BYTES_PER_MB
    if unit == "mb":
        return int(mbyte)
    if unit == "gb":
        return mbyte / 1024

    # unit 'text'
    if mbyte < 1024:
        return f"{int(mbyte)} MB"
    return f"{int(mbyte / 1024)} GB"


