class XtraBackupRunner(multiprocessing.Process):

    """Xtrabackup multiprocessing class."""

    def __init__(self, config_path=None, *args, **kwargs):
        multiprocessing.Process.__init__(self, *args, **kwargs)

        self.config_path = config_path
        self.logger = None

    def run(self):
        """Iterate over servers."""

        # Read config
        if self.config_path is None:
            local_cfg = LocalConfig()
        else:
            local_cfg = LocalConfig(self.config_path)

        logging_dir = local_cfg.raw_cfg_data['ALL_SERVERS'].get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        logging_stdout = local_cfg.raw_cfg_data['ALL_SERVERS'].get('LOGGING_DIR', DEFAULT_LOGGING_STDOUT)
        self.logger = logging_setup(logging_dir, 'xtrabackup.log', tostdout=logging_stdout)

        # Get a lock
        lockfile_name = os.path.join(logging_dir, '.lock_xtrabackup')
        lock = FileLock(lockfile_name, timeout=600)
        try:
            lock.acquire()
        except Timeout:
            self.logger.exception(
                "Another instance of this application currently holds the lock."
            )
            sys.exit(1)

        try:
            # Obtain server list
            servers = local_cfg.server_data_list

            start_time = time.time()
            self.logger.info('>>>>>>>>>>>>>>>>>> Backup started.')
            self.logger.info('Total servers: %s', len(servers))

            settings = servers[0]  # Merged settings of 1st server
            # Enable debug if configured
            if settings.get('DEBUG') or local_cfg.raw_cfg_data["ALL_SERVERS"].get(
            "DEBUG"
        ):
                if isinstance(self.logger, logging.Logger):
                    self.logger.setLevel(logging.DEBUG)
                else:
                    self.logger = logging_setup(logging_dir, 'xtrabackup.log', logging.DEBUG)

            # Raise open_file_limit
            rlimit = settings.get('XTRABACKUP_RLIMIT', [65536, 65536])
            try:
                resource.setrlimit(resource.RLIMIT_NOFILE, rlimit)
                self.logger.info('Raised open_file_limit to %s', rlimit)
            except ValueError:
                self.logger.warn('Unable to raise open_file_limit')

            # Iterate over servers
            for server_data in servers:
                bkp = Xtrabackup(server_data, logger=self.logger)
                # Catch exceptions so we can continue with other servers.
                try:
                    bkp.textfile_collector_write_status(STATUS_OK, backup_running=1)
                    bkp.run()
                    bkp.textfile_collector_write_status(STATUS_OK, backup_running=0)
                except BackupError as exc:
                    self.logger.error(exc.message)
                    self.logger.error('Backup failed for this host.')
                    bkp.notify(STATUS_CRITICAL, exc.message)
                    bkp.textfile_collector_write_status(STATUS_CRITICAL, backup_running=0)
                    sys.exit(1)
                except Exception:
                    self.logger.exception('Unhandled exception occurred.')
                    bkp.textfile_collector_write_status(STATUS_CRITICAL, backup_running=0)
                    sys.exit(1)

                logging_set_host(None, 'xtrabackup.log')

            time_spent = format_seconds_to_hhmmss(time.time() - start_time)
            self.logger.info('>>>>>>>>>>>>>>>>>> Backup finished. Total duration: %s.', time_spent)
        except:
            self.logger.exception("Unhandled exception")
            sys.exit(1)
        finally:
            lock.release()


class Xtrabackup(Backup):

    """Run Xtrabackup for individual server."""

    def __init__(self, server_data, logger=None):
        """Define server options."""
        # Init common options
        super(Xtrabackup, self).__init__(server_data, 'X', logger=logger)

        # XB specific options
        self.builtin_kill = server_data.get('XTRABACKUP_KILL_QUERIES', True)
        self.builtin_kill_timeout = server_data.get('XTRABACKUP_KILL_QUERIES_TIMEOUT', 10)
        self.builtin_kill_type = server_data.get('XTRABACKUP_KILL_QUERY_TYPE', 'select')  # select | all
        # Normalised here rather than in the guard: a blank value carries no path
        # to name, and _run_backup_cmd already omits --defaults-file for one.
        self.defaults_file = server_data.get('XTRABACKUP_DEFAULTS_FILE') or None
        self.incremental_method = server_data.get('XTRABACKUP_INCREMENTAL_METHOD')  # less_space | fast_restore
        self.incremental_cycle = server_data.get('XTRABACKUP_INCREMENTAL_CYCLE', 'weekly')
        self.max_copies = server_data.get('XTRABACKUP_COPIES', 2)
        self.prepare_backup = server_data.get('XTRABACKUP_PREPARE', False)
        self.prepare_memory = server_data.get('XTRABACKUP_PREPARE_MEMORY', '2G')
        self.xtrabackup_extra_args = server_data.get('XTRABACKUP_EXTRA_ARGS')
        self.verify_innodb = server_data.get('XTRABACKUP_VERIFY', True)
        self.local_ssh_dest = server_data.get('XTRABACKUP_LOCAL_SSH_DESTINATION')
        self.xtrabackup_replica_info = server_data.get('XTRABACKUP_REPLICA_INFO', True)
        self.xtrabackup_rsync = server_data.get('XTRABACKUP_RSYNC', True)
        # Shorter than its siblings on purpose: attribute names survive
        # minification, and this file sits within bytes of the Nomad payload limit.
        self.aes_keyfile = server_data.get('XTRABACKUP_AES256_KEYFILE')
        self.xtrabackup_desync_pxc = server_data.get('XTRABACKUP_DESYNC_PXC', False)
        self.xtrabackup_stop_replica = server_data.get('XTRABACKUP_STOP_REPLICA', False)
        self.xtrabackup_lock_ddl = server_data.get('XTRABACKUP_LOCK_DDL', False)
        self.xtrabackup_lock_ddl_timeout = server_data.get('XTRABACKUP_LOCK_DDL_TIMEOUT', 60)
        self.xtrabackup_quiet = server_data.get('XTRABACKUP_QUIET', False)

        # Upload options to keep backward-compatibility
        self.server_setting = server_data

        # report options
        self.report_options['options'] = {
            'copies': self.max_copies
        }

        # enable textfile collector metric
        self.textfile_collector_write_enable("X", self.alias, True, "backup")

        (self.report_options['encryption'],
         self.enc_aes,
         self.enc_gpg) = _resolve_encryption(
            server_data.get('ENCRYPTION_FORMAT'), self.aes_keyfile,
            gpg=self.post_run_encrypt)

        # Paths
        self.backup_server_dir = os.path.join(server_data['BACKUP_DIR'], 'xtrabackup', self.alias)
        self.backup_dir = os.path.join(self.backup_server_dir, 'xtrabackup_tmpdir')
        self.latest_link = os.path.join(self.backup_server_dir, 'latest')
        self.xb_log_file = os.path.join(self.logging_dir, 'xtrabackup-%s-%s.log' % (self.alias, time.strftime('%Y%m%d')))

        # Dynamically set
        self.incremental = False
        self.cmd_shell = False
        self.to_lsn = 0
        self.prev_backup_dir = ''  # full path to base backup for incremental
        self.new_backup_dir = ''  # full path to newerly created backup but not moved yet
        self.last_backup_dir = ''  # full path to last backup (a new one after move)
        self.incrementals_dir = ''  # full path to incremental backups for the last full one

        self.is_pxc = self._is_pxc()

    def _clean_after_error(self):
        """Re-sync a desynced PXC node after a failed backup."""
        # Re-sync PXC node
        if self.xtrabackup_desync_pxc:
            self._pxc_desync(new_status=0)

    def _check_config(self) -> None:
        """Reject config that cannot work here, before the host is touched.

        PyMySQL ignores an option file it cannot read and connects with no
        credentials, so an unusable option file otherwise costs a failed backup
        reported as an authentication error naming no file.

        Only ``DEFAULTS_FILE`` has a default, so it is the only key that can name
        a path nobody chose -- hence the suffix distinguishing the two.

        Runs here rather than in the initializer, which the caller builds outside
        the loop that reports a ``BackupError`` -- raising there loses the message,
        the notification and the collector status.

        Both checks share this one method deliberately: each answers the same
        question -- can this config run on this host -- and one call site is one
        thing for ``run`` to not forget.

        :raises BackupError: If either option file cannot be read, or the selected
            binary cannot run the compression algorithm.
        """
        bin_cmd = self.xtrabackup_bin_cmd
        algorithm = self.compression_algorithm
        allowed = supported_compression(bin_cmd)
        if self.compress and algorithm not in allowed:
            raise BackupError(
                f'algorithm {algorithm} is not one of {allowed} for {bin_cmd}'
            )
        for path, key in (
            (self.defaults_cnf_file, 'DEFAULTS_FILE'),
            (self.defaults_file, 'XTRABACKUP_DEFAULTS_FILE'),
        ):
            if path is not None and not (
                os.path.isfile(path) and os.access(path, os.R_OK)
            ):
                if key not in self.server_data:
                    key += ' default'
                raise BackupError(f'cannot read defaults file {path} from {key}')

    def run(self):
        """Start backup for individual server."""
        start_time = time.time()
        self._check_config()

        # Check running conditions
        if self.only_if_running_replica:
            self.is_replica = self._is_running_replica()
            if not self.is_replica:
                self.logger.info('Not running replica, ignoring this host.')
                return

        if self.only_if_read_only:
            self.is_replica = self._is_read_only()
            if not self.is_replica:
                self.logger.info('Not read_only, ignoring this host.')
                return

        # Create backup dir
        if os.path.isdir(self.backup_dir) and os.path.basename(self.backup_dir) == 'xtrabackup_tmpdir':
            shutil.rmtree(self.backup_dir)
        try:
            os.makedirs(self.backup_dir)
        except OSError as err:
            raise BackupError(str(err))

        # Check for free disk space
        if self.check_disk_space:
            is_free, msg = is_free_space(self.backup_server_dir, logger=self.logger)
            if not is_free:
                self._clean_after_error()
                raise BackupError(msg)

        # Check for PXC
        if not self.is_pxc:
            self.xtrabackup_desync_pxc = False

        # Desync PXC node
        if self.xtrabackup_desync_pxc:
            self._pxc_desync(new_status=1)

        # Run actual backup. When XTRABACKUP_STOP_REPLICA is enabled, xtrabackup
        # owns the replica SQL-thread pause via --safe-slave-backup (see
        # _run_backup_cmd / _replica_backup_flags), so PMM Extensions no longer issues its
        # own STOP/START REPLICA SQL_THREAD.
        self._run_backup_cmd()

        # Resync PXC node
        if self.xtrabackup_desync_pxc:
            for _ in list(range(60)):
                if self._pxc_desync(new_status=0):
                    break
                self.logger.info('Sleeping 10 secs to re-try syncing Galera node.')
                time.sleep(10)
            else:
                self.logger.error('Galera node left desynced.')

        # Backup other files
        if self.host == 'localhost' and not self.incremental:
            try:
                self.backup_mycnf(self.last_backup_dir)
                self.backup_certs(self.last_backup_dir)
            except BackupError as e:
                self.logger.warning('%s', e)

        # Purge changed page tracking
        if self._is_track_changed_pages():
            to_lsn = self._get_incremental_lsn(self.last_backup_dir)
            if to_lsn > 0:
                self._purge_track_changed_pages(to_lsn)

        # Purge old backups
        self._purge_old_backups()

        # Runs for xtrabackup too (not just mariadb-backup): it mops up plaintext
        # stragglers inline encryption misses (the copied my.cnf) and closes the
        # gap where the aes256 path shipped entirely unverified.
        if self.enc_aes:
            self.encrypt_files_aes256(self.last_backup_dir)
            if not is_encrypted_dir(
                self.last_backup_dir, method='aes256', logger=self.logger
            ):
                raise BackupError('AES-256 verify failed: %s' % (self.last_backup_dir,))

        # Encrypt backup w/o upload as a separate option.
        # No hardlinking or rsync upload to avoid the mess.
        if self.enc_gpg and self.post_run_encrypt:
            self.logger.info('Post-run backup encryption is enabled.')
            if self.enc_aes:
                self.logger.info('Backup used PXB built-in encryption.')
            else:
                encrypt_dir(self.last_backup_dir, self.logger, **self.dir_encrypt_config)
        # Try to save some disk space
        elif self.hardlink and self.max_copies > 1:
            self._save_disk_space()

        # Upload if needed
        upload_providers = {
        }
        upload_destination = None
        for upload_type in sorted(self.upload_type):
            self.enable_upload(self.last_backup_dir)
            # Configs written before the provider names were lowercased record
            # them capitalised, and those stored tasks still dispatch here.
            provider = upload_providers.get(upload_type.casefold())
            # A selected provider absent from the map means this variant was not built
            # to carry it. Warning and skipping would report the backup OK with no
            # offsite copy, so fail loudly instead.
            if provider is None:
                raise BackupError('Unsupported upload type: %r' % (upload_type,))
            uploader = XtraBackupUpload(
                upload_type=upload_type,
                upload_provider=provider,
                settings=self.server_setting,
                logger=self.logger,
            )
            uploader.run()
            remote_path = uploader.report_options.get("options", {}).get("remote_path")
            if remote_path:
                upload_destination = remote_path

        # Report we are OK :)
        time_spent = format_seconds_to_hhmmss(time.time() - start_time)

        # Alert for zero-size backups
        backup_size = get_dir_size(self.last_backup_dir)
        if backup_size == '0 MB':
            msg = 'WARN Backup completed without data. Duration: %s.' % time_spent
            notify_status = STATUS_WARNING
        else:
            msg = 'OK Backup complete. Duration: %s. Size: %s.' % (time_spent, backup_size)
            notify_status = STATUS_OK
        self.logger.info(msg)
        self.notify(notify_status, msg)

        if self.last_backup_dir and os.path.isdir(self.last_backup_dir):
            try:
                _write_run_result(
                    self.last_backup_dir,
                    get_dir_size(self.last_backup_dir, "bytes"),
                    upload_destination,
                )
            except Exception:
                self.logger.exception("Failed to write the run-result file.")

    def encrypt_files_aes256(self, dir_path: "str | None") -> None:
        """Encrypt plaintext files under a directory with xbcrypt/AES-256.

        Recurses ``dir_path``, skipping files already carrying a ``.xbcrypt``
        suffix and the backup metadata PMM Extensions keeps in plaintext to read post-backup.
        This is the xbcrypt analogue of the gpg :func:`encrypt_dir`: for
        ``mariadb-backup`` (no inline encryption) it encrypts the whole finished
        directory; for ``xtrabackup`` it only mops up plaintext stragglers (e.g.
        the copied ``my.cnf``). Files are encrypted a handful at a time,
        mirroring :meth:`DirectoryEncryptor.encrypt_dir`.

        :param dir_path: Directory whose plaintext files are encrypted.
        :raises BackupError: If any file fails to encrypt.
        """
        if not dir_path:
            return
        # A list comprehension (not a generator) fully drains rglob() before any
        # file is touched, so the walk can't re-yield the .xbcrypt files the pool
        # is creating underneath it. Bounded by CPU count so xbcrypt can't starve
        # the host on small hosts.
        thread_pool.ThreadPool(min(5, os.cpu_count() or 5)).map(self._run_encrypt_file_aes256, [
            p for p in Path(dir_path).rglob('*')
            if p.is_file() and p.suffix != '.xbcrypt' and p.name not in PLAINTEXT_METADATA_FILES
        ])

    def _run_xbcrypt(self, cmd: list[str], remove_path: "str | Path") -> None:
        """Run an ``xbcrypt`` command, then delete ``remove_path`` on success.

        :param cmd: The ``xbcrypt`` argument list to execute.
        :param remove_path: File removed once the command succeeds (the plaintext
            input on encrypt, the ``.xbcrypt`` input on decrypt).
        :raises BackupError: If the command exits non-zero.
        """
        self.logger.info('Running: %s', ' '.join(cmd))
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode != 0:
            # Concurrent ThreadPool workers (encrypt_files_aes256) can race here on
            # simultaneous xbcrypt failures; unguarded deliberately, a lock doesn't
            # fit the 16 KiB Nomad payload budget. Low likelihood, low blast radius.
            self._clean_after_error()
            raise BackupError('xbcrypt failed on %s: %s' % (remove_path, err))
        os.remove(remove_path)

    def _run_encrypt_file_aes256(self, file_path: "str | Path") -> None:
        """Encrypt a single file in place with xbcrypt/AES-256.

        :param file_path: Plaintext file to encrypt; no-ops when it is absent.
        :raises BackupError: If the underlying xbcrypt run fails (propagated
            from :meth:`_run_xbcrypt`).
        """
        if os.path.exists(file_path):
            self._run_xbcrypt(
                [XBCRYPT_BIN, '--encrypt-algo=AES256',
                 '--encrypt-key-file=%s' % (self.aes_keyfile,),
                 '--input=%s' % (file_path,), '--output=%s.xbcrypt' % (file_path,)],
                file_path,
            )

    def _check_ssh(self):
        """
        Test sudo over SSH

         Pseudo-terminal will not be allocated because stdin is not a terminal.
         sudo: sorry, you must have a tty to run sudo

        """
        verify_sudo_cmd = 'ssh -tt %s %s "sudo echo"' % (
            SSH_ARGS, self.host,
        )
        return os.system(verify_sudo_cmd) == 0

    def _run_backup_cmd(self):
        """Run backup command.

        Optionally, performs incremental or streaming backup.
        """
        version = self._get_version()
        xtrabackup_cmd = []
        if self.xtrabackup_bin_cmd == 'xtrabackup':
            xtrabackup_cmd.append(XTRABACKUP_BIN_REAL)
        elif self.xtrabackup_bin_cmd == 'mariadb-backup':
            xtrabackup_cmd.append(XTRABACKUP_BIN_MARIADB)
        else:
            xtrabackup_cmd.append(XTRABACKUP_BIN)

        if self.defaults_file:
            xtrabackup_cmd.append('--defaults-file=%s' % (self.defaults_file,))

        if self.xtrabackup_lock_ddl:
            xtrabackup_cmd.append('--lock-ddl')
            xtrabackup_cmd.append('--lock-ddl-timeout=%d' % self.xtrabackup_lock_ddl_timeout)

        if self.xtrabackup_rsync:
            xtrabackup_cmd.append('--rsync')

        if self.is_pxc:
            xtrabackup_cmd.append('--galera-info')

        if self.xtrabackup_bin_cmd in ['mariadb-backup', 'xtrabackup']:
            bkp_dir_ts = time.strftime('%Y-%m-%d_%H-%M-%S')
            xtrabackup_cmd.append('--backup')
            xtrabackup_cmd.append('--target-dir=%s' % os.path.join(self.backup_dir, bkp_dir_ts))
        else:
            xtrabackup_cmd.append(self.backup_dir)

        xtrabackup_cmd.extend(
            _replica_backup_flags(self.xtrabackup_replica_info, self.xtrabackup_stop_replica)
        )

        if self.builtin_kill:
            xtrabackup_cmd.append('--kill-long-queries-timeout=%s' % (self.builtin_kill_timeout,))
            xtrabackup_cmd.append('--kill-long-query-type=%s' % (self.builtin_kill_type,))
            self.logger.info('Using built-in kill queries with xtrabackup %s', version)

        self._define_incremental_options()
        if self.incremental:
            xtrabackup_cmd.append('--incremental-lsn=%s' % (self.to_lsn,))
            if self.xtrabackup_bin_cmd == 'innobackupex':
                xtrabackup_cmd.append('--incremental')

        if self.prepare_backup:
            self.logger.info('Compression disabled due to a full prepare configured.')
            self.compress = False

        if self.compress:
            self.verify_innodb = False
            self.logger.info('Enabling compression using %s', self.compression_algorithm)
            xtrabackup_cmd.append('--compress={}'.format(self.compression_algorithm))

        if _should_inline_encrypt(self.xtrabackup_bin_cmd, self.enc_aes):
            self.verify_innodb = False
            xtrabackup_cmd.append('--encrypt=AES256')
            xtrabackup_cmd.append('--encrypt-key-file=%s' % (self.aes_keyfile,))

        if self.xtrabackup_extra_args:
            xtrabackup_cmd.extend(self.xtrabackup_extra_args.split(' '))

        self.logger.info('Backup data...')

        if self.host in ['localhost', "127.0.0.1"]:
            # Regular backup
            self.logger.info('Running: %s', ' '.join(xtrabackup_cmd))
        else:
            # Streaming backup:
            # - if HOST is not localhost than we backup the remote server by connecting to it via ssh and
            # streaming backup back to the backup server;
            # - XTRABACKUP_LOCAL_SSH_DESTINATION can be optionally set, by default it is auto-detected;
            # - no support for incrementals, can be done later giving the lsn instead the base-dir.
            self.logger.info('HOST is not localhost so streaming backup from it...')
            if not self.local_ssh_dest:
                this_host = self._get_own_ssh_remote_addr(self.host)
                self.local_ssh_dest = '%s@%s' % (os.getenv('LOGNAME'), this_host)
                self.logger.info('Local SSH destination is detected as %s', self.local_ssh_dest)

            # safe check in case of HOST defined for other reason than streaming it
            this_host = self.local_ssh_dest[(self.local_ssh_dest.find('@') + 1):]
            if self.host != this_host:
                now_str = time.strftime('%Y-%m-%d_%H-%M-%S')
                stream_dir = os.path.join(self.backup_dir, now_str)
                os.makedirs(stream_dir)
                if not self._check_ssh():
                    raise BackupError('Unable to run sudo over SSH')
                xtrabackup_cmd = 'ssh -tt %s %s "sudo %s --stream=xbstream | ssh %s %s \"xbstream -x -C %s\""' % (
                    SSH_ARGS, self.host, ' '.join(xtrabackup_cmd).replace('--rsync', ''),
                    SSH_ARGS, self.local_ssh_dest, stream_dir
                )
                self.cmd_shell = True
                self.logger.info('Running: %s', xtrabackup_cmd)
            else:
                self.logger.info('HOST == Destination, streaming canceled and proceeding with normal backup.')
                self.logger.info('Running: %s', ' '.join(xtrabackup_cmd))

        xb_log_stream = open(self.xb_log_file, 'a')
        backup_proc = subprocess.Popen(xtrabackup_cmd, shell=self.cmd_shell, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for line in backup_proc.stdout:
            decoded = line.decode()
            if self.xtrabackup_quiet and _COPY_LINE_RE.match(decoded):
                continue
            if self.logging_stdout:
                sys.stdout.write(decoded)
            xb_log_stream.write(decoded)
        backup_proc.wait()
        backup_proc.communicate()
        if backup_proc.returncode != 0:
            xb_log_stream = open(self.xb_log_file, 'r')
            err = xb_log_stream.readlines()[-1]
            msg = 'Xtrabackup failed: %s For more details, see %s' % (err, self.xb_log_file)
            self._clean_after_error()
            raise BackupError(msg)

        new_backup = self._list_backups(self.backup_dir)[-1]
        self.new_backup_dir = os.path.join(self.backup_dir, new_backup)

        # Merge incremental into base, so the last backup becomes a full one.
        if self.incremental and self.incremental_method == 'fast_restore':
            self._merge_incremental()

        # Fully prepare the latest backup
        if self.prepare_backup:
            self._prepare_backup(self.new_backup_dir)

        # Final move of backup
        if self.incremental and self.incremental_method == 'less_space':
            # Move incremental to <base>_incrementals inside backup server dir
            if not os.path.isdir(self.incrementals_dir):
                os.mkdir(self.incrementals_dir)
            shutil.move(self.new_backup_dir, self.incrementals_dir)
            self.last_backup_dir = os.path.join(self.incrementals_dir, new_backup)
        else:
            # Verify backup
            if self.verify_innodb:
                self._verify_innodb_files(self.new_backup_dir)

            # Move actual backup out of xtrabackup_tmpdir to backup server dir
            shutil.move(self.new_backup_dir, self.backup_server_dir)
            self.last_backup_dir = os.path.join(self.backup_server_dir, new_backup)

            # Symlink to latest backup
            if os.path.islink(self.latest_link):
                os.unlink(self.latest_link)
            os.symlink(new_backup, self.latest_link)

        if self.enc_aes:
            self._decrypt_metadata_file(self.aes_keyfile, self.last_backup_dir,
                                        XTRABACKUP_CHECKPOINTS)
            self._decrypt_metadata_file(self.aes_keyfile, self.last_backup_dir,
                                        XTRABACKUP_INFO, compressible=True)

        if self.compress:
            self._decompress_info_file(self.last_backup_dir)

        self.logger.info('OK Xtrabackup complete: %s', self.last_backup_dir)

    def _decrypt_file_aes256(
        self, keyfile: str, input_path: str, output_path: str
    ) -> None:
        """Decrypt one xbcrypt/AES-256 file to ``output_path`` and drop the input.

        No-ops when ``input_path`` is absent, so callers need not pre-check.

        :param keyfile: Path to the AES-256 key file.
        :param input_path: Path to the ``.xbcrypt`` file to decrypt.
        :param output_path: Path the decrypted plaintext is written to.
        :raises BackupError: If decryption fails.
        """
        if os.path.exists(input_path):
            self._run_xbcrypt(
                [XBCRYPT_BIN, '-d', '--encrypt-algo=AES256',
                 '--encrypt-key-file=%s' % (keyfile,),
                 '--input=%s' % (input_path,), '--output=%s' % (output_path,)],
                input_path,
            )

    def _decrypt_metadata_file(self, keyfile, path, name, *, compressible=False):
        """Decrypt one metadata file PMM Extensions keeps readable after the AES-256 pass.

        The AES-256 pass runs after compression, so a compressible file is on disk
        under its compressed name. Composing that name here rather than at the call
        site keeps it where a test can reach it.

        :param keyfile: Path to the AES-256 keyfile.
        :param path: The backup directory holding the file.
        :param name: The file's name within ``path``, without the ``.xbcrypt`` suffix.
        :param compressible: Whether compression renames this file.
        """
        if compressible and self.compress:
            name += self.get_compression_ext()
        target = '%s/%s' % (path, name)
        self._decrypt_file_aes256(keyfile, target + '.xbcrypt', target)

    def _decompress_info_file(self, path):
        """Decompress xtrabackup_info after backup."""
        tool, ext = self.get_compression_tool(), self.get_compression_ext()
        info_file_out = 'xtrabackup_info'
        info_file = os.path.join(path, '{}{}'.format(info_file_out, ext))
        if tool == QPRESS_BIN:
            cmd = [QPRESS_BIN, '-d', info_file, path]
        elif tool == ZSTD_BIN:
            cmd = [ZSTD_BIN, '-d', info_file, '-o', os.path.join(path, info_file_out)]
        elif tool == LZ4_BIN:
            cmd = [LZ4_BIN, '-d', info_file, os.path.join(path, info_file_out)]
        else:
            raise BackupError('Unsupported format for xtrabackup_info: {}'.format(ext))
        if not os.path.exists(cmd[0]):
            raise BackupError('Unable to locate decompression tool: {}'.format(cmd[0]))
        if not os.path.exists(info_file):
            raise BackupError('Unable to locate info file: {}'.format(info_file))

        self.logger.info('Running: %s', ' '.join(cmd))
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode != 0:
            msg = 'Info file decompress failed: %s' % (err)
            self._clean_after_error()
            raise BackupError(msg)
        else:
            os.remove(os.path.join(path, info_file))

    def _list_backups(self, path):
        """Get list of dirs with the existing backups."""
        dname_re = re.compile(BACKUP_DIR_REGEX[self.backup_code])
        dir_list = sorted([dname for dname in os.listdir(path)
                           if os.path.isdir(os.path.join(path, dname)) and dname_re.search(dname)])

        return dir_list

    def _get_version(self):
        """Extract Xtrabackup version."""
        if self.xtrabackup_bin_cmd == 'mariadb-backup':
            cmd = [XTRABACKUP_BIN_MARIADB, '--version']
            pattern = r'based on MariaDB server ([0-9a-z.]+)'
        else:
            cmd = [XTRABACKUP_BIN_REAL, '--version']
            pattern = r'version ([0-9a-z.]+)'
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode == 0:
            # xtrabackup uses STDERR for output
            # xtrabackup version 2.2.3 based on MySQL server 5.6.17 Linux (x86_64) (revision id: )
            # xtrabackup version 2.1.2 for Percona Server 5.1.59 unknown-linux-gnu (x86_64) (revision id: 611)
            # /usr/bin/mariabackup based on MariaDB server 10.4.8-MariaDB debian-linux-gnu (x86_64)
            match = re.search(pattern, err.decode())
            if match:
                return match.group(1)

        self.logger.warn('Error getting xtrabackup version')

    def _define_incremental_options(self):
        """Check incremental conditions and define options.

        There are two methods of doing incremental backups:

        1. fast_restore. It creates a full backup only if none exists. Than each time it makes a copy of
        the previous backup, creates incremental one from that, merges into the base and a new full backup
        becomes ready. This method is useful when you don't care about the disk space and taking incremental
        backup is really fast, usually with MySQL 5.6+.

        2. less_space. It creates a full backup as often as configured, daily or weekly. This means that
        any following backup run within the current cycle will be an incremental one. All incremental backups
        within the same cycle and _incrementals folder are chained to each other. So to prepare such backup
        you need to merge them one by one in order, this takes time. Once the cycle is over, a new full backup
        is created and so on. This method is useful when you want to save the disk space and create backups fast.

        An incremental cycle daily means a full backup runs once per day. Weekly means once per week on the given
        day: weekly - stands for 1 (Monday) or a number 1..7 - Monday-Sunday.
        """
        if self.incremental_method not in ['fast_restore', 'less_space']:
            return

        self.prepare_backup = False

        backup_dirs = self._list_backups(self.backup_server_dir)
        if not backup_dirs:
            self.logger.info('Creating initial full backup as a base dir for incrementals.')
            return

        self.prev_backup_dir = os.path.join(self.backup_server_dir, backup_dirs[-1])
        if not self._is_good_base_backup(self.prev_backup_dir):
            self.logger.warn('Looks like you are trying to run incremental backup against '
                             'a fully prepared or encrypted base. Thus, running a new full backup.')
            return

        if self.incremental_method == 'fast_restore':
            self.compress = False
            if self._is_compressed_backup(self.prev_backup_dir):
                self.logger.warn('Looks like you are trying to run incremental backup against a compressed base '
                                 'but we will need to merge it. Thus, running a full backup.')
                return

        if self.incremental_method == 'less_space':
            self.hardlink = False
            if not self._is_ongoing_incremental_cycle(self.prev_backup_dir, self.incremental_cycle):
                self.logger.info('Starting a new cycle "%s" of incremental backups. '
                                 'Thus, running a full backup.', self.incremental_cycle)
                return

            self.logger.info('Incremental cycle "%s" is ongoing.', self.incremental_cycle)
            self.incrementals_dir = '%s_incrementals' % (self.prev_backup_dir,)
            if os.path.isdir(self.incrementals_dir):
                backup_dirs = self._list_backups(self.incrementals_dir)
                if backup_dirs:
                    self.prev_backup_dir = os.path.join(self.incrementals_dir, backup_dirs[-1])

        # Get LSN from previous backup
        self.to_lsn = self._get_incremental_lsn(self.prev_backup_dir)
        if self.to_lsn == 0:
            self.logger.warn('to_lsn was not found on backup dir %s. Thus, running a full backup.', backup_dirs[-1])
            return

        self.incremental = True
        self.logger.info('Creating incremental backup with "%s" method and base %s',
                         self.incremental_method, backup_dirs[-1])

    def _merge_incremental(self):
        """Merge incremental backup into base dir."""
        prev_backup = os.path.basename(self.prev_backup_dir)
        self.logger.info('Merging a new incremental backup %s into base %s...',
                         prev_backup, os.path.basename(self.new_backup_dir))

        base_dir = os.path.join(self.backup_dir, prev_backup)
        self.logger.info('Copying base backup to %s', self.backup_dir)
        shutil.copytree(self.prev_backup_dir, base_dir)
        self.logger.info('Copy complete.')

        # Prepare base
        self._prepare_backup(base_dir, redo_only=True)

        # Apply incremental to the base
        self._prepare_backup(base_dir, self.new_backup_dir, redo_only=True)

        # Drop incremental and rename full to it
        shutil.rmtree(self.new_backup_dir)
        shutil.move(base_dir, self.new_backup_dir)

        self.logger.info('OK Merge complete.')

    def _prepare_backup(self, base_dir, incremental_dir=None, redo_only=False):
        """Prepare backup by applying logs."""
        if self.xtrabackup_bin_cmd in ['mariadb-backup', 'xtrabackup']:
            xtrabackup_cmd = [XTRABACKUP_BIN_MARIADB if self.xtrabackup_bin_cmd == 'mariadb-backup'
                                                     else XTRABACKUP_BIN_REAL,
                              '--prepare', '--use-memory=%s' % self.prepare_memory, '--target-dir=%s' % base_dir]
        else:
            xtrabackup_cmd = [XTRABACKUP_BIN, '--apply-log', '--use-memory=%s' % self.prepare_memory, base_dir]

        if redo_only:
            if self.xtrabackup_bin_cmd == 'xtrabackup':
                xtrabackup_cmd.append('--apply-log-only')
            else:
                xtrabackup_cmd.append('--redo-only')
        elif not incremental_dir:
            self.logger.info('Fully preparing backup...')

        if incremental_dir:
            self.logger.info('Applying incremental to the base...')
            xtrabackup_cmd.append('--incremental-dir=%s' % (incremental_dir,))
        elif redo_only:
            self.logger.info('Preparing base...')

        self.logger.info('Running: %s', ' '.join(xtrabackup_cmd))
        xb_log_stream = open(self.xb_log_file, 'a')
        proc = subprocess.Popen(xtrabackup_cmd, stdout=xb_log_stream, stderr=xb_log_stream)
        proc.communicate()
        if proc.returncode != 0:
            xb_log_stream = open(self.xb_log_file, 'r')
            err = xb_log_stream.readlines()[-1]
            msg = 'Xtrabackup prepare failed: %s For more details, see %s' % (err, self.xb_log_file)
            self._clean_after_error()
            raise BackupError(msg)

        self.logger.info('OK Preparing complete.')

    def _purge_old_backups(self):
        """Purge old backups.

        Setting max copies to 0 will disable deletion.
        """
        self.logger.info('Purging old backups...')
        # Remove backup_dir which is xtrabackup_tmpdir as the latest backup was already moved away
        # Safety check
        if os.path.basename(self.backup_dir) == 'xtrabackup_tmpdir':
            shutil.rmtree(self.backup_dir)

        # Purging
        purges = 0
        dir_list = self._list_backups(self.backup_server_dir)
        self.logger.info('Keeping copies (max %s): %s', self.max_copies,
                         ', '.join(sorted(dir_list)[-self.max_copies:]))
        for dir_ in sorted(dir_list)[:-self.max_copies]:
            path = os.path.join(self.backup_server_dir, dir_)
            shutil.rmtree(path)
            self.logger.info('* Dir %s removed.', dir_)
            # Check for related incrementals dir
            if os.path.isdir('%s_incrementals' % (path,)):
                shutil.rmtree('%s_incrementals' % (path,))
                self.logger.info('* Related dir %s_incrementals removed.', dir_)
            purges += 1

        self.logger.info('OK %s dirs purged.', purges)
        return purges

    def _purge_track_changed_pages(self, to_lsn):
        """"Purge innodb track changed pages"""
        sql = "PURGE CHANGED_PAGE_BITMAPS BEFORE %s" % to_lsn

        try:
            self._query_mysql(sql)
        except BackupError:
            return False

        self.logger.info('Chnaged page bitmaps purged until %s', to_lsn)

        return True

    def _save_disk_space(self):
        """Hardlink backups to save disk space."""
        prev_backup_dir = None
        dir_list = self._list_backups(self.backup_server_dir)
        if len(dir_list) > 1:
            prev_backup_dir = os.path.join(self.backup_server_dir, dir_list[-2])
        if not prev_backup_dir:
            self.logger.info('Checksumming backup...')
            get_dir_dict(self.last_backup_dir, False)
            self.logger.info('OK Checksum complete.')
        else:
            self.logger.info('Hardlinking backups...')
            get_dir_dict(self.last_backup_dir, False)
            hl_files = hardlink_dirs(prev_backup_dir, self.last_backup_dir, False)
            bytes_saved = 0
            for file_data in list(hl_files.values()):
                bytes_saved += file_data[1]
            self.report_options['hl_mb'] = round(bytes_saved / 1024 / 1024)
            self.logger.info('OK hardlinking complete. %d MB saved.', round(bytes_saved / 1024 / 1024))

    def _verify_innodb_files(self, path):
        """Verify InnoDB files."""
        self.logger.info('Verifying InnoDB files with innochecksum...')
        count = 0
        for root, _, files in os.walk(path):
            for ibd in files:
                if not (ibd.endswith('.ibd') or ibd.startswith('ibdata')):
                    continue
                cmd = [INNOCHECKSUM_BIN, os.path.join(root, ibd)]
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                _, err = proc.communicate()
                count += 1
                if proc.returncode != 0:
                    msg = 'Error running %s. Error: %s' % (' '.join(cmd), err)
                    self._clean_after_error()
                    raise BackupError(msg)

        self.logger.info('OK Checksummed %d InnoDB files.', count)

    def _is_good_base_backup(self, path: str) -> bool:
        """Return whether the base backup can seed an incremental run.

        A fully prepared base cannot, and under ``fast_restore`` neither can an
        encrypted one: that method copies the base and feeds it to ``--prepare``,
        which needs real InnoDB files rather than their encrypted renames.
        ``less_space`` never feeds the base's InnoDB files to anything -- it reads
        only the plaintext checkpoints for an LSN -- so it tolerates one.

        :param path: Base backup directory.
        :return: True if the base can seed an incremental, False otherwise.
        """
        chk_file = os.path.join(path, 'xtrabackup_checkpoints')
        if not os.path.isfile(chk_file):
            return False

        with open(chk_file, 'r') as file_:
            row = file_.readline().rstrip()
            if row == 'backup_type = full-prepared':
                return False

        if self.incremental_method != 'fast_restore':
            return True

        return not self._is_encrypted_base(path)

    def _is_encrypted_base(self, path: str) -> bool:
        """Return whether the base backup holds any encrypted file.

        Detection cannot rely on the job's own encryption settings: a base encrypted
        by an earlier run stays encrypted after those settings are turned off. Nor can
        it require the whole directory to be encrypted, the way ``is_encrypted_dir``
        does -- an encryption pass that dies part-way leaves a mixed base behind after
        the backup has already been moved into the retained directory, and one renamed
        table is enough to break ``--prepare``. The renames both formats leave are the
        whole answer, so no file is opened and no ``gpg`` process is spawned: a host
        that only ever encrypted with xbcrypt has no reason to have that binary.

        :param path: Base backup directory.
        :return: True if any file in the base is encrypted, False otherwise.
        """
        return any(p.suffix in ('.xbcrypt', '.gpg') for p in Path(path).rglob('*'))

    def _is_track_changed_pages(self):
        """Returns true if innodb_track_changed_pages is enabled."""
        try:
            result = self._query_mysql('SELECT @@innodb_track_changed_pages')
        except BackupError:
            return False

        if result['@@innodb_track_changed_pages'] == 1:
            self.logger.info('innodb_track_changed_pages is enabled.')
            return True

        return False

    @staticmethod
    def _get_incremental_lsn(path):
        """Grab LSN from xtrabackup_checkpoints file in the backup folder."""
        to_lsn = 0
        chk_file = os.path.join(path, 'xtrabackup_checkpoints')
        if not os.path.isfile(chk_file):
            return to_lsn

        with open(chk_file, 'r') as file_:
            content = file_.readlines()

        for line in content:
            match = re.search(r'^to_lsn = (\d+)\n$', line)
            if match:
                to_lsn = int(match.group(1))
                break

        return to_lsn

    @staticmethod
    def _is_compressed_backup(backup_path: str) -> bool:
        """Return whether the base backup can be merged as uncompressed plaintext.

        Only the plaintext compression suffixes are probed, because an encrypted
        base is already rejected by :meth:`_is_good_base_backup` before this runs.
        The closing fallback is wider than compression by design: any base whose
        ``ibdata1`` is missing or renamed cannot be merged as it stands, whatever
        did the renaming.

        :param backup_path: Base backup directory.
        :return: True if the base cannot be merged without unpacking it first.
        """
        if not os.path.exists(os.path.join(backup_path, 'xtrabackup_checkpoints')):
            return False

        for comp in ('qp', 'zst', 'lz4'):
            if os.path.exists(os.path.join(backup_path, 'ibdata1.%s' % (comp,))):
                return True

        return not os.path.exists(os.path.join(backup_path, 'ibdata1'))

    def _is_ongoing_incremental_cycle(self, path, cycle):
        """Check if the current incremental cycle is ongoing for the given path name.

        daily - a full backup runs once a day.
        weekly - a full backup runs once a week on Monday.
        1..7 - also weekly cycle but a full backup runs once a week on the specified day Monday-Sunday.
        """
        # Built, not spelled out: the 9-member literal measures 16,387 bytes after
        # minify + gzip (3 over the 16 KiB Nomad limit). This form measures 16,377
        # (7 bytes headroom). Re-check with scripts/check_nomad_payload_size.py
        # --report.
        cycles = ['daily', 'weekly'] + list('1234567')
        if cycle not in cycles:
            msg = 'Invalid XTRABACKUP_INCREMENTAL_CYCLE: %s (want %s)' % (cycle, cycles)
            self._clean_after_error()
            raise BackupError(msg)

        path = os.path.basename(path)
        today = time.strftime('%Y-%m-%d')
        if cycle == 'daily':
            if path.startswith(today):
                return True
        else:
            if cycle == 'weekly':
                cycle = 1  # Monday

            if int(cycle) != datetime.datetime.today().isoweekday() or path.startswith(today):
                return True

        return False

    def _get_own_ssh_remote_addr(self, host):
        """Get own remote_addr when connecting to the host via SSH."""
        cmd = 'ssh %s %s env|grep SSH_CLIENT|cut -d= -f2|cut -d" " -f1' % (SSH_ARGS, host)
        proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, err = proc.communicate()
        if proc.returncode != 0:
            self.logger.info('Running: %s', cmd)
            msg = 'Unable to determine own SSH remote address: %s' % (err,)
            self._clean_after_error()
            raise BackupError(msg)

        return out.decode().rstrip()


