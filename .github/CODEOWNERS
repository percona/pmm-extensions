# Order matters: GitHub uses LAST-MATCH-WINS, so broad rules first,
# specific overrides last. Owners are teams, so a change in who reviews
# is a team-membership change, not an edit here:
#   @percona/pmm-extensions-devs         default owner
#   @percona/pmm-extensions-review-be    backend reviewers
#   @percona/pmm-extensions-review-fe    frontend reviewers
#   @percona/pmm-extensions-review-core  backend core and release-sensitive paths

# Default
*                                       @percona/pmm-extensions-devs

# ── Backend ─────────────────────────────────────────────────────────
/app/                                   @percona/pmm-extensions-review-be
/tests/                                 @percona/pmm-extensions-review-be
/scripts/                               @percona/pmm-extensions-review-be
/sidecar/                               @percona/pmm-extensions-review-be
/snippets/                              @percona/pmm-extensions-review-be
/alembic.ini                            @percona/pmm-extensions-review-be
/settings.yaml                          @percona/pmm-extensions-review-be

# ── Backend foundation ──────────────────────────────────────────────
/app/*.py                               @percona/pmm-extensions-review-core
/app/api/                               @percona/pmm-extensions-review-core
/app/core/                              @percona/pmm-extensions-review-core
/app/tasks/                             @percona/pmm-extensions-review-core
/app/inventory/                         @percona/pmm-extensions-review-core
/app/extensions/*.py                    @percona/pmm-extensions-review-core
/app/extensions/api/                    @percona/pmm-extensions-review-core
/app/extensions/routes/                 @percona/pmm-extensions-review-core
/app/extensions/snippets/               @percona/pmm-extensions-review-core
/app/extensions/bundle_upload/          @percona/pmm-extensions-review-core
/app/extensions/migrations/             @percona/pmm-extensions-review-core
/app/extensions/apps/framework/*.py     @percona/pmm-extensions-review-core

# Generic helpers and dev tooling inside the foundation directories
/app/core/exceptions.py                 @percona/pmm-extensions-review-be
/app/core/log.py                        @percona/pmm-extensions-review-be
/app/core/pagination/                   @percona/pmm-extensions-review-be
/app/core/utils/                        @percona/pmm-extensions-review-be
/app/core/utils/cli_args.py             @percona/pmm-extensions-review-core
/app/core/utils/fields.py               @percona/pmm-extensions-review-core
/app/core/utils/path.py                 @percona/pmm-extensions-review-core
/app/extensions/apps/framework/conformance.py  @percona/pmm-extensions-review-be
/app/extensions/apps/framework/list_query.py   @percona/pmm-extensions-review-be
/app/extensions/apps/framework/scaffold.py     @percona/pmm-extensions-review-be

# ── Frontend (including its dependencies) ───────────────────────────
/frontend/                              @percona/pmm-extensions-review-fe

# OpenAPI specs and the client generated from them follow backend changes
/frontend/packages/api/specs/           @percona/pmm-extensions-devs
/frontend/packages/api/src/generated/   @percona/pmm-extensions-devs

# ── Sensitive: Python dependencies ──────────────────────────────────
/pyproject.toml                         @percona/pmm-extensions-review-core
/poetry.lock                            @percona/pmm-extensions-review-core
/poetry.toml                            @percona/pmm-extensions-review-core

# ── Sensitive: build / release / runtime image ──────────────────────
/Makefile                               @percona/pmm-extensions-review-core
/.pre-commit-config.yaml                @percona/pmm-extensions-review-core
/.trivyignore.yaml                      @percona/pmm-extensions-review-core
/Containerfile.base                     @percona/pmm-extensions-review-core
/sidecar/Containerfile.sidecar          @percona/pmm-extensions-review-core
/CHANGELOG.md                           @percona/pmm-extensions-review-core
/scripts/release.py                     @percona/pmm-extensions-review-core
/scripts/changelog.py                   @percona/pmm-extensions-review-core

# ── CI / repo automation ────────────────────────────────────────────
/.github/                               @percona/pmm-extensions-review-core
/build/                                 @percona/pmm-extensions-review-core

# Review guidance inside .github is everyone's to maintain
/.github/copilot-instructions.md        @percona/pmm-extensions-devs
/.github/instructions/                  @percona/pmm-extensions-devs
/.github/PULL_REQUEST_TEMPLATE.md       @percona/pmm-extensions-devs
