// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		string(
			name: 'releaseTag',
			defaultValue: 'main',
			description: 'Commit reference'
		)
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		booleanParam(
			name: 'pushImage',
			defaultValue: false,
			description: 'Push the image to the registry'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/pmm-extensions.git'
						]
					]
				)
				script {
					env.GIT_COMMIT_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
					echo "Git commit SHA: ${env.GIT_COMMIT_SHA}"
					echo "Original ref: ${params.releaseTag}"
				}
			}
		}
		stage('Execute CI') {
			steps {
				build job: 'PMM-Extensions/CI', parameters: [
					[$class: 'StringParameterValue', name: 'releaseTag', value: "${env.GIT_COMMIT_SHA}"],
					[$class: 'StringParameterValue', name: 'pyVersion', value: "${PYTHON_VERSION}"],
					[$class: 'BooleanParameterValue', name: 'pushImage', value: Boolean.valueOf("${params.pushImage}")],
					[$class: 'BooleanParameterValue', name: 'pushImageDocker', value: false]
				], propagate: true, wait: true
			}
		}
	}

	post {
		always {
			cleanWs()
		}
	}
}
