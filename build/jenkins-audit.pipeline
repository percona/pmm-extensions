// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		string(
			name: 'releaseTag',
			description: 'Commit reference'
		)
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		POETRY_VIRTUALENVS_IN_PROJECT = "true"

		// Pinned to match the python:*-slim tag in Containerfile.base.
		PYTHON_VERSION = "3.14.10"
		PYTHON_BUILD_TAG = "20261110"
		PYTHON = "python3.14"

		// Pinned to match .github/workflows/ci.yml.
		NODE_VERSION = "22.13.0"
		PNPM_VERSION = "11.1.2"
		PATH = "${env.WORKSPACE}/build/python/bin:${env.WORKSPACE}/build/node/bin:${env.PATH}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/pmm-extensions.git'
						]
					]
				)
			}
		}

		stage('Prepare environment') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				sh '''
					set -o errexit
					set -o pipefail

					PY_TARBALL="cpython-${PYTHON_VERSION}+${PYTHON_BUILD_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz"
					PY_RELEASE="https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_BUILD_TAG}"
					PY_TMP="$(mktemp -d)"
					curl -fsSL -o "${PY_TMP}/${PY_TARBALL}" "${PY_RELEASE}/${PY_TARBALL}"
					curl -fsSL "${PY_RELEASE}/SHA256SUMS" \
						| grep " ${PY_TARBALL}$" \
						| (cd "${PY_TMP}" && sha256sum --check --status)
					tar -xzf "${PY_TMP}/${PY_TARBALL}" -C "${PY_TMP}"
					rm -rf build/python
					mkdir -p build
					mv "${PY_TMP}/python" build/python
					rm -rf "${PY_TMP}"
					${PYTHON} --version

					# An older releaseTag (a patch branched from a pre-3.14 tag) caps
					# requires-python below 3.14, so it installs on the agent's 3.11.
					VENV_PYTHON="${PYTHON}"
					if grep -qE '^requires-python = ".*<3\\.([0-9]|1[0-4])(\\.[0-9]+)?"' pyproject.toml; then
						VENV_PYTHON=python3.11
					fi
					${VENV_PYTHON} --version

					${VENV_PYTHON} -m venv venv
					ln -s venv .venv
					venv/bin/python -m pip install --no-cache -U pip wheel

					${VENV_PYTHON} -m venv build/venv
					build/venv/bin/python -m pip install --no-cache -U pip wheel 'poetry==2.4.1'
					# Pre-install so Poetry's project-scoped plugin self-install
					# never runs — that solver hits PyPI live and trips
					# `solver.min-release-age` in poetry.toml on fresh transitives.
					build/venv/bin/python -m pip install --no-cache 'poetry-plugin-export>=1.9.0,<2.0.0'
					build/venv/bin/poetry check --lock --strict
					build/venv/bin/poetry install --with audit

					# Node + pnpm for the frontend pre-commit hooks (oxfmt, oxlint).
					# `npm i -g pnpm` (not corepack) matches ci.yml and avoids
					# corepack's outdated signing-key check in Node 22.13.0.
					NODE_TARBALL="node-v${NODE_VERSION}-linux-x64"
					NODE_TMP="$(mktemp -d)"
					curl -fsSL -o "${NODE_TMP}/${NODE_TARBALL}.tar.xz" "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_TARBALL}.tar.xz"
					curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
						| grep " ${NODE_TARBALL}.tar.xz$" \
						| (cd "${NODE_TMP}" && sha256sum --check --status)
					tar -xJf "${NODE_TMP}/${NODE_TARBALL}.tar.xz" -C "${NODE_TMP}"
					rm -rf build/node
					mv "${NODE_TMP}/${NODE_TARBALL}" build/node
					rm -rf "${NODE_TMP}"
					build/node/bin/node --version
					build/node/bin/npm install -g "pnpm@${PNPM_VERSION}"
					(cd frontend && pnpm install --frozen-lockfile)
				'''
			}
		}

		stage('Pre-commit checks') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo 'Running pre-commit ..'
				// `language: system` hooks shell out to bare `python3` and import the
				// project's dependencies, so the venv must lead PATH.
				withEnv(["PATH+VENV=${env.WORKSPACE}/venv/bin"]) {
					sh '''
						set -o errexit
						set -o pipefail

						make run-pre-commit
					'''
				}
			}
		}

		stage('Audit : Bandit') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo 'Running bandit ..'
				sh '''
					set -o errexit
					set -o pipefail

					make bandit
				'''
			}
		}

		stage('Audit : pip-audit' ) {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo 'Running pip-audit ..'
				sh '''
					set -o errexit
					set -o pipefail

					POETRY=build/venv/bin/poetry make pip-audit
				'''
			}
		}
	}

	post {
		always {
			cleanWs()
		}
	}
}
