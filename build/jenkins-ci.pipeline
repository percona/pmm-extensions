// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		string(
			name: 'releaseTag',
			description: 'Commit reference'
		)
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		booleanParam(
			name: 'pushImage',
			defaultValue: false,
			description: 'Push the image to the registry'
		)
		booleanParam(
			name: 'pushImageDocker',
			defaultValue: false,
			description: 'Push the image to the Docker registry'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/pmm-extensions.git'
						]
					]
				)
			}
		}

		stage('Perform audit') {
			steps {
				build job: 'PMM-Extensions/Audit', parameters: [
					[$class: 'StringParameterValue', name: 'releaseTag', value: "${RELEASE_VER}"],
					[$class: 'StringParameterValue', name: 'pyVersion', value: "${PYTHON_VERSION}"]
				], propagate: true, wait: true
			}
		}

		stage('Build image') {
			steps {
				build job: 'PMM-Extensions/Build', parameters: [
					[$class: 'StringParameterValue', name: 'releaseTag', value: "${RELEASE_VER}"],
					[$class: 'StringParameterValue', name: 'pyVersion', value: "${PYTHON_VERSION}"],
					[$class: 'BooleanParameterValue', name: 'pushImage', value: Boolean.valueOf("${params.pushImage}")],
					[$class: 'BooleanParameterValue', name: 'pushImageDocker', value: Boolean.valueOf("${params.pushImageDocker}")]
				], propagate: true, wait: true
			}
		}

		/*stage('Deploy') {
			steps {
				build job: 'PMM-Extensions/Deploy', parameters: [
					string(name: 'releaseTag', value: "${RELEASE_VER}"),
					string(name: 'pyVersion', value: "${PYTHON_VERSION}")
				], propagate: true, wait: true
			}
		}*/
	}

	post {
		always {
			cleanWs()
		}
	}
}
