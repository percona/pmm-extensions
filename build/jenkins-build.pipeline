// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		string(
			name: 'releaseTag',
			description: 'Commit reference'
		)
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		booleanParam(
			name: 'pushImage',
			defaultValue: false,
			description: 'Push the image to the registry'
		)
		booleanParam(
			name: 'pushImageDocker',
			defaultValue: false,
			description: 'Push the image to the Docker registry'
		)
		string(
			name: 'customImageTag',
			defaultValue: '',
			description: 'Optional image tag override (OCI tag: starts [A-Za-z0-9_], then [A-Za-z0-9._-], max 128; the latest* family and release shapes like 3, 3.10, 3.10.0, 3.10.0-rc1, v3.10.0 are reserved); skips git-tag naming, never pushes :latest'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		POETRY_VIRTUALENVS_IN_PROJECT = "true"
		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/pmm-extensions.git'
						]
					]
				)

				script {
					env.GIT_COMMIT_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
					env.GIT_TAG_COUNT = sh(returnStdout: true, script: "git tag --contains ${env.GIT_COMMIT_SHA} | wc -l").trim()

					if (env.GIT_TAG_COUNT.toInteger() > 1) {
						currentBuild.result = "FAILURE"
						throw new Exception("Multiple tags (${env.GIT_TAG_COUNT}) matched for ${env.GIT_COMMIT_SHA}")
					}

					if (env.GIT_COMMIT_SHA != params.releaseTag)  {
						currentBuild.result = "FAILURE"
						throw new Exception("Unexpected revision: expected ${params.releaseTag}, found ${env.GIT_COMMIT_SHA}")
					}

					if (env.GIT_TAG_COUNT.toInteger() == 0) {
						echo "Setting GIT_TAG to match commit reference"
						env.GIT_TAG = env.GIT_COMMIT_SHA
					} else {
						echo "Setting GIT_TAG to matching tag"
						env.GIT_TAG = sh(returnStdout: true, script: "git tag --contains ${env.GIT_COMMIT_SHA}").trim()
					}
					echo "Git commit SHA: ${env.GIT_COMMIT_SHA}"
					echo "Git tag: ${env.GIT_TAG}"

					env.IMAGE_TAG = env.GIT_TAG
					env.IMAGE_ALIAS_TAGS = ''
					if (env.GIT_TAG ==~ /^v\d+\.\d+\.\d+$/) {
						def version = env.GIT_TAG.substring(1)
						def parts = version.tokenize('.')
						env.IMAGE_TAG = version
						env.IMAGE_ALIAS_TAGS = "${parts[0]}.${parts[1]} ${parts[0]} latest"
					} else if (env.GIT_TAG ==~ /^v\d+\.\d+\.\d+rc\d+$/) {
						def rcAt = env.GIT_TAG.lastIndexOf('rc')
						def version = env.GIT_TAG.substring(1, rcAt)
						env.IMAGE_TAG = "${version}-rc${env.GIT_TAG.substring(rcAt + 2)}"
						env.IMAGE_ALIAS_TAGS = "${version}-rc"
					}

					def customTag = (params.customImageTag ?: '').trim()
					if (customTag) {
						if (!(customTag ==~ /^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$/)) {
							currentBuild.result = "FAILURE"
							throw new Exception("Invalid customImageTag '${customTag}': must match ^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}\$ (max 128 chars)")
						}
						// IMAGE_TAG drives the unguarded primary push, so a "latest" family or
						// release tag would republish an image the registry already maps to a
						// different commit
						if (customTag ==~ /^latest([._-].*)?$/ || customTag ==~ /^v?\d+(\.\d+){0,2}(-?rc\d*)?$/) {
							currentBuild.result = "FAILURE"
							throw new Exception("Reserved customImageTag: ${customTag}")
						}
						env.GIT_TAG = customTag
						env.IMAGE_TAG = customTag
						env.IMAGE_ALIAS_TAGS = ''
						env.RELEASE_VER = customTag
						sh "git tag -f -- \"${customTag}\" HEAD"
						echo "Using custom image tag: ${customTag}"
					}
				}
			}
		}

		stage('Build base image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			// TODO: if possible, build this only when necessary - TBC how to automatically determine this
			steps {
				echo 'Building base image ..'
				sh '''
					set -o errexit
					set -o pipefail

					podman image exists "extensions:builder" && podman image rm "extensions:builder" || true
					buildah build -f Containerfile.base --compress --force-rm --squash --no-cache --format oci --memory 100M --isolation rootless --tag "extensions:builder"
				'''
			}
		}

		stage('Build PMM Extensions image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			// TODO: if possible, build this only when necessary - TBC how to automatically determine this
			steps {
				echo "Building PMM Extensions image for ${RELEASE_VER} .."
				sh '''
					set -o errexit
					set -o pipefail

					RELEASE_VER="${GIT_TAG}" make image
				'''
			}
		}

		stage('Verify image app set') {
			options {
				timeout(time: 5, unit: 'MINUTES')
			}

			steps {
				echo "Verifying the app set of the ${RELEASE_VER} image .."
				sh '''
					set -o errexit
					set -o pipefail

					export CONTAINER_RUNTIME=podman

					sidecar/verify_image_apps.sh "extensions:${GIT_TAG}" restricted
				'''
			}
		}

		stage('Push PMM Extensions image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			when {
				expression {
					return params.pushImage
				}
			}

			// TODO: if possible, build this only when necessary - TBC how to automatically determine this
			steps {

				withCredentials([string(credentialsId: 'PMM_EXTENSIONS_DOCKER_HUB_WRITE_TOKEN', variable: 'DOCKER_TOKEN')]) {
					sh '''
						set -o errexit
						set -o pipefail

						for tag in ${IMAGE_TAG} ${IMAGE_ALIAS_TAGS}; do
							echo "Pushing labbox-mini.tp.int.percona.com:5555/pmm-extensions:${tag}"
							podman image push extensions:${GIT_TAG} labbox-mini.tp.int.percona.com:5555/pmm-extensions:${tag}
						done
					'''

					script {
						if (params.pushImageDocker) {
							sh '''
							set -o errexit
							set -o pipefail

							echo -n "${DOCKER_TOKEN}" | podman login --authfile .dockerhub --username percona --password-stdin docker.io
							for tag in ${IMAGE_TAG} ${IMAGE_ALIAS_TAGS}; do
								echo "Pushing docker.io/percona/pmm-extensions:${tag}"
								podman image push --authfile .dockerhub extensions:${GIT_TAG} docker.io/percona/pmm-extensions:${tag}
							done

							podman logout --authfile .dockerhub docker.io
							'''
						}
					}
				}
			}
		}

	}

	post {
		always {
			cleanWs()
		}
	}
}
