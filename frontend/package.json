{
  "name": "@pmm-extensions/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pmm-extensions/shell dev",
    "build": "pnpm -r --filter '@pmm-extensions/*' run build",
    "preview": "pnpm --filter @pmm-extensions/shell preview",
    "lint": "oxlint --config oxlintrc.json .",
    "lint:fix": "oxlint --config oxlintrc.json --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r type-check",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @pmm-extensions/e2e test:e2e",
    "test:e2e:ui": "pnpm --filter @pmm-extensions/e2e test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @pmm-extensions/e2e test:e2e:headed",
    "storybook": "pnpm --filter @pmm-extensions/framework storybook",
    "build-storybook": "pnpm --filter @pmm-extensions/framework build-storybook",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "6.39.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
